{
  "name": "arcraiders-data",
  "type": "module",
  "scripts": {
    "check": "prettier --check .",
    "format": "prettier --write .",
    "map-events:update": "node scripts/update-map-events.js && bun run map-events:format",
    "map-events:format": "prettier --write map-events/map-events.json",
    "projects:update": "node scripts/update-projects.js && bun run projects:format",
    "projects:format": "prettier --write projects.json",
    "items:update": "node scripts/update-items.js && bun run items:format",
    "items:format": "prettier --write items/*.json",
    "quests:update": "node scripts/update-quests.js && bun run quests:format",
    "quests:format": "prettier --write quests/*.json",
    "hideout:update": "node scripts/update-hideout.js && bun run hideout:format",
    "hideout:format": "prettier --write hideout/*.json",
    "arcs:update": "node scripts/update-arcs.js && prettier --write bots.json",
    "sync": "node scripts/update-items.js && node scripts/update-quests.js && node scripts/update-hideout.js && node scripts/update-projects.js && node scripts/update-arcs.js && prettier --write \"items/*.json\" \"quests/*.json\" \"hideout/*.json\" projects.json bots.json && node scripts/aggregate.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-sort-json": "^4.1.1",
    "safe-stable-stringify": "^2.5.0"
  },
  "private": true
}
